---
import Base from '../layouts/Base.astro';
---

<Base>
  <!-- Hero -->
  <header class="hero">
    <div class="hero-inner">
      <h1 class="hero-name">Blake Reichenbach</h1>
      <div class="hero-accent-line" aria-hidden="true"></div>
      <p class="hero-tagline">
        I'm drawn to curiosity and intention. Whether it's software, essays, fiction,
        or a cabin in the Appalachian foothills — the common thread is a commitment to craft.
      </p>
    </div>
  </header>

  <!-- Gradient accent bar -->
  <div class="gradient-bar" aria-hidden="true"></div>

  <main>
    <!-- About -->
    <section class="section about" id="about" aria-labelledby="about-heading">
      <div class="section-inner">
        <h2 id="about-heading">
          <span class="section-label">About</span>
          <span class="sr-only">Blake Reichenbach</span>
        </h2>
        <div class="about-body">
          <p>
            I'm a product manager by trade and a writer by compulsion, which means I spend a lot of time
            thinking about why things are built the way they are — and whether they could be better.
          </p>
          <p>
            As a PM, I've spent my career on ambitious, zero-to-one launches. The work I'm most proud of
            starts with genuine curiosity about what people actually need — not what they say they want,
            not what's easiest to build — and ends with something that earns their trust. I think of that
            as product taste: the ability to turn empathy into decisions.
          </p>
          <p>
            That same instinct shows up everywhere else. PRactical exists because I saw a gap in the market
            for a workout tracker that respects the user's intelligence — no bloat, no dark patterns, just
            a clean tool that does exactly what it promises. Non-Slop Fun exists because I believe the
            well-examined life is worth writing about, and that genuine creative and cultural commentary is
            an act of resistance against the default mode of mindless scrolling. The Berea Writers Cabin
            exists because a space should mean something — it should invite the kind of thinking that
            doesn't happen on a laptop screen.
          </p>
          <p>
            I'm based in Kentucky. I'm a certified personal trainer who mostly just trains himself. I'm
            working on two novels — an Appalachian dark fantasy about ecology, class, and what it means to
            come home, and a high fantasy rooted in the mythology of gods and the people who live in their
            shadow. Both are works in progress, which feels like the right place for them to be.
          </p>
          <p>
            If you've landed here, you're probably curious, you make things, and you're a little skeptical
            of anything that was built to game your attention rather than earn it. Welcome.
          </p>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section class="section projects" id="projects" aria-labelledby="projects-heading">
      <div class="section-inner">
        <h2 id="projects-heading">
          <span class="section-label">Projects</span>
        </h2>
        <div class="projects-grid">

          <article class="project-card">
            <span class="card-tag">Newsletter</span>
            <h3 class="card-title">Non-Slop Fun</h3>
            <p class="card-description">
              Reflection is resistance. Non-Slop Fun is a newsletter about creative and cultural
              commentary — examining the things worth examining, and celebrating the well-examined life.
            </p>
            <a
              href="https://www.nonslopfun.com"
              class="card-cta"
              target="_blank"
              rel="noopener noreferrer"
            >Read it &rarr;</a>
          </article>

          <article class="project-card">
            <span class="card-tag">iOS App</span>
            <h3 class="card-title">PRactical Workouts</h3>
            <p class="card-description">
              A workout tracker for lifters who want a clean, intelligent tool without the bloat.
              No social features, no AI gimmicks — just straightforward progressive overload tracking
              done right.
            </p>
            <a
              href="https://www.practicalworkouts.com"
              class="card-cta"
              target="_blank"
              rel="noopener noreferrer"
            >Download &rarr;</a>
          </article>

          <article class="project-card">
            <span class="card-tag">Writing &amp; Craft</span>
            <h3 class="card-title">Creator's Hearth</h3>
            <p class="card-description">
              A niche site for writers who take the craft seriously. Practical guidance, honest takes,
              and a growing library of resources for fiction writers at every stage.
            </p>
            <a href="#" class="card-cta">Visit &rarr;</a>
          </article>

          <article class="project-card">
            <span class="card-tag">Short-Term Rental · Berea, KY</span>
            <h3 class="card-title">Berea Writers Cabin</h3>
            <p class="card-description">
              A creative retreat in the Appalachian foothills, steeped in regional charm and designed
              for the kind of thinking that requires a change of scenery.
            </p>
            <span class="card-cta-disabled">Bookings Coming Soon</span>
          </article>

        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="section contact" id="contact" aria-labelledby="contact-heading">
      <div class="section-inner">
        <h2 id="contact-heading">
          <span class="section-label">Get in Touch</span>
        </h2>
        <p class="contact-intro">
          If something here resonated — or if you're thinking about working together — I'd love to
          hear from you. Whether it's a consulting engagement, a creative collaboration, or just a
          good conversation, feel free to reach out.
        </p>
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          class="contact-form"
          aria-label="Contact form"
        >
          <input type="hidden" name="form-name" value="contact" />

          <div class="form-group">
            <label for="name" class="form-label">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="form-input"
            />
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="form-input"
            />
          </div>

          <div class="form-group">
            <label for="message" class="form-label">Message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              class="form-input form-textarea"
            ></textarea>
          </div>

          <button type="submit" class="form-submit">Send &rarr;</button>
        </form>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-copy">&copy; 2026 Blake Reichenbach</span>
      <nav class="footer-links" aria-label="Project links">
        <a href="https://www.nonslopfun.com" target="_blank" rel="noopener noreferrer">Non-Slop Fun</a>
        <a href="https://www.practicalworkouts.com" target="_blank" rel="noopener noreferrer">PRactical Workouts</a>
        <a href="#">Creator's Hearth</a>
      </nav>
    </div>
  </footer>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    background-color: var(--color-hero-bg);
    color: var(--color-hero-text);
    padding: 7rem 2rem 6rem;
  }

  .hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .hero-name {
    font-family: var(--font-heading);
    font-size: clamp(36px, 6vw, 52px);
    font-weight: 700;
    color: var(--color-hero-text);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .hero-accent-line {
    width: 32px;
    height: 1px;
    background-color: var(--color-accent-terra);
    margin: 12px 0;
  }

  .hero-tagline {
    font-family: var(--font-body);
    font-size: clamp(16px, 2.5vw, 18px);
    font-style: italic;
    font-weight: 300;
    color: var(--color-hero-muted);
    max-width: 560px;
    line-height: 1.7;
  }

  /* ── Gradient bar ── */
  .gradient-bar {
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #c4783a, #8a6a3a, #4a6e3a);
  }

  /* ── Shared section layout ── */
  .section {
    padding: 5rem 2rem;
  }

  .section-inner {
    max-width: 740px;
    margin: 0 auto;
  }

  /* ── About ── */
  .about {
    background-color: var(--color-bg);
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--color-ink);
    line-height: 1.8;
    max-width: 680px;
  }

  /* ── Projects ── */
  .projects {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .project-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(42, 34, 24, 0.06);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-tag {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-terra);
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.25;
  }

  .card-description {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-ink-light);
    line-height: 1.7;
    flex: 1;
  }

  .card-cta {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-accent-terra);
    text-decoration: none;
    transition: text-decoration 0.15s;
  }

  .card-cta:hover {
    text-decoration: underline;
  }

  .card-cta-disabled {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 400;
    color: var(--color-ink-light);
    opacity: 0.7;
  }

  /* ── Contact ── */
  .contact {
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .contact-intro {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--color-ink);
    line-height: 1.8;
    max-width: 600px;
    margin-bottom: 2.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 560px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-light);
  }

  .form-input {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    padding: 12px 14px;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-ink);
    width: 100%;
    transition: border-color 0.2s;
    outline: none;
  }

  .form-input:focus {
    border-color: var(--color-ink-light);
  }

  .form-textarea {
    resize: vertical;
    min-height: 140px;
  }

  .form-submit {
    align-self: flex-start;
    background-color: var(--color-ink);
    color: var(--color-hero-text);
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.05em;
    border: none;
    border-radius: 2px;
    padding: 12px 28px;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .form-submit:hover {
    opacity: 0.85;
  }

  .form-submit:focus-visible {
    outline: 2px solid var(--color-accent-terra);
    outline-offset: 3px;
  }

  /* ── Footer ── */
  .footer {
    background-color: var(--color-hero-bg);
    padding: 2rem;
  }

  .footer-inner {
    max-width: 740px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-copy {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--color-hero-muted);
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-links a {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--color-hero-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-links a:hover {
    color: var(--color-hero-text);
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .hero {
      padding: 5rem 1.5rem 4rem;
    }

    .section {
      padding: 3.5rem 1.5rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
