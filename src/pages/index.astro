---
import Base from '../layouts/Base.astro';
---

<Base>

  <!-- ══════════════════════════════════════════ HERO ══════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero-left">
      <nav class="hero-nav" aria-label="Site navigation">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#work">Product Work</a>
        <a href="#contact">Contact</a>
      </nav>
      <div class="hero-identity">
        <h1 class="hero-name">M. Blake<br/>Reichenbach</h1>
        <p class="hero-role">Writer, Product Manager, &amp; Tinkerer</p>
      </div>
      <div class="hero-bottom">
        <p class="hero-eyebrow">Long story short:</p>
        <p class="hero-script">I build things that make a difference.</p>
      </div>
    </div>
    <div class="hero-right">
      <img src="/images/blake-personal.jpg" alt="Blake Reichenbach" />
    </div>
  </section>

  <!-- ════════════════════════════════════════ INDEX NAV ═══════════════════════════════════════ -->
  <section class="index-nav" aria-label="Site sections">
    <div class="index-left">
      <p class="index-wordmark">Blake<br/>Reichenbach</p>
      <p class="index-descriptor">Product manager · writer · builder of things. Draft to craft and curiosity.</p>
    </div>
    <nav class="index-links">
      <a href="#about" class="index-link">
        <span class="index-link-title">About</span>
        <span class="index-link-num">01</span>
      </a>
      <a href="#projects" class="index-link index-link--terra">
        <span class="index-link-title">Projects</span>
        <span class="index-link-num">02</span>
      </a>
      <a href="#work" class="index-link">
        <span class="index-link-title">Product Work</span>
        <span class="index-link-num">03</span>
      </a>
      <a href="#contact" class="index-link index-link--terra">
        <span class="index-link-title">Contact</span>
        <span class="index-link-num">04</span>
      </a>
    </nav>
  </section>

  <!-- ════════════════════════════════════════ ABOUT ═══════════════════════════════════════════ -->
  <section class="about" id="about">
    <div class="about-photo">
      <img src="/images/blake-editorial.jpg" alt="Blake Reichenbach" />
    </div>
    <div class="about-content">
      <span class="stamp">01 — About</span>
      <h2 class="about-heading">
        PM by Trade.<br/>
        <em>Writer by Passion.</em>
      </h2>
      <div class="about-body">
        <p>I'm innately curious — about ideas, about people, about why things work the way they do and how they could work better. That curiosity isn't a hobby; it's the thread running through everything I do.</p>
        <p>It's what pulled me into tech in the first place. Curiosity about marketers — how they think, what they're actually trying to do, where their tools fail them — is what made me a good PM. I spent years on zero-to-one launches at HubSpot, building products used by millions, and now bring that same instinct to Alignable, where I work on tools that help small business owners connect and grow.</p>
        <p>The same impulse drives my writing. Curiosity about storytelling, about identity and place and the stories we inherit — that's what makes me a writer. And curiosity about how to translate my interests into something useful for other people is what led me to build PRactical and start Non-Slop Fun.</p>
        <p>I follow the rabbit holes. I pick things apart. Then I build something better.</p>
      </div>
      <div class="about-details">
        <div class="about-detail">
          <span class="detail-label">Based in</span>
          <span class="detail-value">Kentucky, USA</span>
        </div>
        <div class="about-detail">
          <span class="detail-label">Day job</span>
          <span class="detail-value">Senior Product Manager · Alignable</span>
        </div>
        <div class="about-detail">
          <span class="detail-label">Building</span>
          <span class="detail-value">Non-Slop Fun · PRactical · Creator's Hearth · Berea Writers Cabin</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════ PROJECTS ════════════════════════════════════════ -->
  <div class="projects-banner" id="projects">
    <span class="stamp stamp--light">02 — Projects</span>
    <h2 class="projects-heading">Things I've <em>built.</em></h2>
  </div>

  <!-- Non-Slop Fun ─────────────────── -->
  <div class="project-feature project-feature--dark">
    <div class="project-feature-visual">
      <img src="/images/nonslop.png" alt="Non-Slop Fun — a figure in a suit holding coffee" />
    </div>
    <div class="project-feature-body">
      <span class="project-tag">Newsletter</span>
      <h3 class="project-feature-title">Non-Slop<br/>Fun</h3>
      <p class="project-feature-desc">Reflection is resistance. Creative and cultural commentary about the things worth examining — and a celebration of the well-examined life.</p>
      <div id="nsf-carousel-container"></div>
      <a href="https://www.nonslopfun.com" class="project-cta" target="_blank" rel="noopener noreferrer">Read it →</a>
    </div>
  </div>

  <!-- PRactical Workouts ──────────── -->
  <div class="project-feature project-feature--cream">
    <div class="project-feature-body project-feature-body--invert">
      <span class="project-tag project-tag--olive">iOS App</span>
      <h3 class="project-feature-title project-feature-title--dark">PRactical<br/>Workouts</h3>
      <p class="project-feature-desc project-feature-desc--dark">A workout tracker for lifters who want a clean, intelligent tool without the bloat. No social features, no AI gimmicks — just straightforward progressive overload tracking done right.</p>
      <a href="https://www.practicalworkouts.com" class="project-cta project-cta--dark" target="_blank" rel="noopener noreferrer">Download →</a>
    </div>
    <div class="project-feature-visual project-feature-visual--screens">
      <div class="screens-stack">
        <img src="/images/practical-screenshot1.png" alt="PRactical home screen" class="screen screen-back" />
        <img src="/images/practical-screenshot2.png" alt="PRactical workout log" class="screen screen-front" />
        <img src="/images/practical-screenshot3.png" alt="PRactical history view" class="screen screen-far" />
      </div>
    </div>
  </div>

  <!-- Creator's Hearth + Cabin ─────── -->
  <div class="project-pair">
    <div class="project-card" style="--card-bg: #252c3a;">
      <div class="project-card-visual">
        <img src="/images/creators-hearth.png" alt="Creator's Hearth logo — a watercolor fireplace" />
      </div>
      <div class="project-card-body">
        <span class="project-tag">Writing &amp; Craft</span>
        <h3 class="project-card-title">Creator's Hearth</h3>
        <p class="project-card-desc">A niche site for writers who take the craft seriously. Practical guidance, honest takes, and a growing library of resources for fiction writers at every stage.</p>
        <a href="https://www.creatorshearth.com/" class="project-cta" target="_blank" rel="noopener noreferrer">Check it out →</a>
      </div>
    </div>
    <div class="project-card" style="--card-bg: #2d3f4d;">
      <div class="project-card-visual project-card-visual--photo">
        <img src="/images/cabin.jpg" alt="Berea Writers Cabin in the Appalachian foothills" />
      </div>
      <div class="project-card-body">
        <span class="project-tag">Short-Term Rental · Berea, KY</span>
        <h3 class="project-card-title">Berea Writers Cabin</h3>
        <p class="project-card-desc">A creative retreat in the Appalachian foothills, steeped in regional charm and designed for the kind of thinking that requires a change of scenery.</p>
        <span class="project-cta-muted">Bookings Coming Soon</span>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════════ PRODUCT WORK ════════════════════════════════════════ -->
  <section class="work" id="work">
    <div class="work-top">
      <div class="work-left">
        <div class="work-header">
          <span class="stamp stamp--light">03 — Product Work</span>
          <h2 class="work-heading">Selected<br/><em>past work.</em></h2>
          <p class="work-intro">Zero-to-one launches at HubSpot. Platform scale. Products used by millions.</p>
        </div>
        <div class="work-entries">
          <div class="work-entry">
            <span class="work-num">01</span>
            <div class="work-entry-body">
              <span class="work-team">Trust &amp; Safety</span>
              <h3 class="work-title">Fraud Detection &amp; ML Modernization</h3>
              <p class="work-desc">Overhauled fraud detection to leverage machine learning. Maintained accuracy across key threat categories while laying the groundwork to shift from reactive to proactive modeling.</p>
            </div>
          </div>
          <div class="work-entry">
            <span class="work-num">02</span>
            <div class="work-entry-body">
              <span class="work-team">Policy &amp; Compliance</span>
              <h3 class="work-title">Digital Services Act Compliance</h3>
              <p class="work-desc">Designed HubSpot's product strategy for EU DSA compliance — navigating regulatory requirements, platform architecture, and user experience at scale.</p>
            </div>
          </div>
          <div class="work-entry">
            <span class="work-num">03</span>
            <div class="work-entry-body">
              <span class="work-team">Content Hub</span>
              <h3 class="work-title">Content Remix</h3>
              <p class="work-desc">Launched Content Remix as part of the creation of Content Hub, quickly establishing the tool as a flagship AI product within HubSpot's portfolio.</p>
            </div>
          </div>
          <div class="work-entry">
            <span class="work-num">04</span>
            <div class="work-entry-body">
              <span class="work-team">Search &amp; Discovery</span>
              <h3 class="work-title">Answer Engine Optimization (AEO)</h3>
              <p class="work-desc">Launched HubSpot's AEO v1 feature set, setting the stage for the XFunnel acquisition and the v2 tools currently on the market.</p>
            </div>
          </div>
          <div class="work-entry">
            <span class="work-num">05</span>
            <div class="work-entry-body">
              <span class="work-team">Social</span>
              <h3 class="work-title">Social Insights</h3>
              <p class="work-desc">Conceptualized and launched HubSpot's Social Insights framework — built on Reddit data — to help brands extract meaningful audience and competitive intelligence.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="work-photo">
        <img src="/images/blake-speaking.jpeg" alt="Blake Reichenbach speaking at HubSpot Spotlight Fall 2024" />
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════ CONTACT ═══════════════════════════════════════════ -->
  <section class="contact" id="contact">
    <div class="contact-left">
      <span class="stamp">04 — Get in Touch</span>
      <h2 class="contact-heading">Let's <span class="contact-script">talk.</span></h2>
      <p class="contact-subhead">Whether it's a consulting engagement, a creative collaboration, or just a good conversation — I'd love to hear from you.</p>
      <div class="contact-photo">
        <img src="/images/blake-dog-selfie.jpg" alt="Blake Reichenbach with his dog" />
      </div>
    </div>
    <div class="contact-right">
      <form name="contact" method="POST" data-netlify="true" class="contact-form" aria-label="Contact form">
        <input type="hidden" name="form-name" value="contact" />
        <div class="form-group">
          <label for="name" class="form-label">Name</label>
          <input type="text" id="name" name="name" required autocomplete="name" class="form-input" />
        </div>
        <div class="form-group">
          <label for="email" class="form-label">Email</label>
          <input type="email" id="email" name="email" required autocomplete="email" class="form-input" />
        </div>
        <div class="form-group">
          <label for="message" class="form-label">Message</label>
          <textarea id="message" name="message" required rows="6" class="form-input form-textarea"></textarea>
        </div>
        <button type="submit" class="form-submit">Send it →</button>
      </form>
    </div>
  </section>

  <!-- ══════════════════════════════════════ FOOTER ════════════════════════════════════════════ -->
  <footer class="site-footer">
    <span class="footer-name">Blake Reichenbach</span>
    <span class="footer-copy">© 2025 · Kentucky, USA</span>
    <div class="footer-links">
      <a href="mailto:blake@howdycuriosity.com">Email</a>
      <a href="https://www.linkedin.com/in/blakereichenbach" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
  </footer>

<script>
  function wireCarousel(root) {
    root.querySelectorAll('.nsf-carousel').forEach(carousel => {
      const grid = carousel.querySelector('.nsf-grid');
      const prev = carousel.querySelector('.nsf-arrow--prev');
      const next = carousel.querySelector('.nsf-arrow--next');
      const step = () => (grid.querySelector('.nsf-card')?.offsetWidth ?? 200) + 6;
      prev.addEventListener('click', () => grid.scrollBy({ left: -step(), behavior: 'smooth' }));
      next.addEventListener('click', () => grid.scrollBy({ left:  step(), behavior: 'smooth' }));
    });
  }

  async function loadNSFPosts() {
    try {
      const res = await fetch('/.netlify/functions/rss-proxy');
      if (!res.ok) return;
      const xml = await res.text();

      function decodeEntities(s) {
        return s.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')
                .replace(/&quot;/g, '"').replace(/&#39;|&#x27;/g, "'");
      }

      const items = (xml.match(/<item>[\s\S]*?<\/item>/g) ?? []).slice(0, 4).map(item => {
        const raw   = item.match(/<title>([\s\S]*?)<\/title>/)?.[1]?.trim() ?? '';
        const title = decodeEntities(raw).replace(/\s*\|.*$/, '');
        const link  = item.match(/<link>([\s\S]*?)<\/link>/)?.[1]?.trim() ?? '';
        const pub   = item.match(/<pubDate>([\s\S]*?)<\/pubDate>/)?.[1]?.trim() ?? '';
        const date  = pub ? new Date(pub).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
        const thumb = item.match(/<enclosure url="([^"]+)"/)?.[1]?.trim() ?? '';
        return { title, link, date, thumb };
      });

      if (items.length === 0) return;

      const container = document.getElementById('nsf-carousel-container');
      if (!container) return;

      container.innerHTML = `
        <div class="nsf-carousel">
          <button class="nsf-arrow nsf-arrow--prev" aria-label="Previous posts" type="button">&#8592;</button>
          <div class="nsf-grid">
            ${items.map(post => `
              <a href="${post.link}" class="nsf-card" target="_blank" rel="noopener noreferrer">
                ${post.thumb
                  ? `<img src="${post.thumb}" alt="${post.title.replace(/"/g, '&quot;')}" class="nsf-card-img" />`
                  : `<div class="nsf-card-img nsf-card-img--placeholder"></div>`
                }
                <div class="nsf-card-overlay">
                  <span class="nsf-card-date">${post.date}</span>
                  <span class="nsf-card-title">${post.title}</span>
                </div>
              </a>
            `).join('')}
          </div>
          <button class="nsf-arrow nsf-arrow--next" aria-label="Next posts" type="button">&#8594;</button>
        </div>
      `;

      wireCarousel(container);
    } catch { /* fail silently */ }
  }

  loadNSFPosts();
</script>

<style is:global>
  /* ──────────────────────────────────── NSF CAROUSEL ────────────────────────────────────────── */
  .nsf-carousel {
    position: relative;
    margin-top: 0.5rem;
  }

  .nsf-grid {
    display: flex;
    overflow-x: hidden;
    gap: 6px;
    scroll-behavior: smooth;
  }

  .nsf-card {
    position: relative;
    flex: 0 0 calc(50% - 3px);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    text-decoration: none;
    display: block;
  }
  .nsf-card:hover .nsf-card-img { transform: scale(1.04); }

  .nsf-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .nsf-card-img--placeholder {
    background: #252c3a;
  }

  .nsf-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 24, 36, 0.92) 0%, rgba(20, 24, 36, 0.3) 55%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1rem 1rem;
    gap: 0.3rem;
  }

  .nsf-card-date {
    font-family: var(--font-ui);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-terra);
  }

  .nsf-card-title {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 400;
    color: var(--color-hero-text);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .nsf-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    background: rgba(20, 24, 36, 0.7);
    color: rgba(255, 248, 212, 0.9);
    border: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    backdrop-filter: blur(4px);
  }
  .nsf-arrow:hover { background: rgba(20, 24, 36, 0.95); }
  .nsf-arrow--prev { left: 6px; }
  .nsf-arrow--next { right: 6px; }

  @media (max-width: 800px) {
    .nsf-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      overflow-x: visible;
    }
    .nsf-card {
      flex: none;
      aspect-ratio: 3 / 4;
    }
    .nsf-arrow { display: none; }
  }
</style>
</Base>

<style>
  /* ─────────────────────────────────────────── TOKENS ───────────────────────────────────────── */
  :root {
    --script: 'Dancing Script', cursive;
  }

  /* ─────────────────────────────────────────── SHARED ───────────────────────────────────────── */
  .stamp {
    display: block;
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-light);
    margin-bottom: 1.25rem;
  }
  .stamp--light { color: rgba(255, 248, 212, 0.5); }

  .placeholder-img {
    background: #d4dac8;
    border: 2px dashed #A3B087;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 2.5rem;
    text-align: center;
  }
  .placeholder-label {
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a7560;
  }
  .placeholder-hint {
    font-family: var(--font-ui);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: #a09080;
  }

  /* ─────────────────────────────────────────── HERO ─────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: 44fr 56fr;
    height: 100dvh;
  }

  .hero-left {
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.75rem 3rem;
  }

  .hero-nav {
    display: flex;
    gap: 2.25rem;
    flex-wrap: wrap;
  }
  .hero-nav a {
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-light);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s, color 0.2s;
  }
  .hero-nav a:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  .hero-identity { display: flex; flex-direction: column; gap: 0.75rem; }

  .hero-name {
    font-family: var(--font-heading);
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .hero-role {
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-light);
  }

  .hero-bottom { padding-bottom: 0.5rem; }

  .hero-eyebrow {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-light);
    margin-bottom: 0.5rem;
  }

  .hero-script {
    font-family: var(--script);
    font-size: clamp(38px, 4.5vw, 60px);
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.15;
  }

  .hero-right {
    position: relative;
    overflow: hidden;
    background: var(--color-hero-bg);
  }
  .hero-right img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* ──────────────────────────────────────── INDEX NAV ────────────────────────────────────────── */
  .index-nav {
    background: var(--color-hero-bg);
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    padding: 5rem 4rem 5rem 3.5rem;
    align-items: center;
    min-height: 80vh;
  }

  .index-left { display: flex; flex-direction: column; gap: 1.25rem; }

  .index-wordmark {
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 248, 212, 0.75);
    line-height: 2;
  }

  .index-descriptor {
    font-family: var(--font-body);
    font-size: 14px;
    font-style: italic;
    color: rgba(255, 248, 212, 0.55);
    line-height: 1.7;
    max-width: 240px;
  }

  .index-links {
    display: flex;
    flex-direction: column;
  }

  .index-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255, 248, 212, 0.1);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .index-link:last-child { border-bottom: 1px solid rgba(255, 248, 212, 0.1); }
  .index-link:hover { opacity: 0.6; }

  .index-link-title {
    font-family: var(--font-heading);
    font-size: clamp(52px, 7vw, 96px);
    font-weight: 400;
    color: var(--color-hero-text);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .index-link--terra .index-link-title {
    font-style: italic;
    color: var(--color-accent-terra);
  }

  .index-link-num {
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: rgba(255, 248, 212, 0.25);
    flex-shrink: 0;
    padding-left: 1rem;
  }

  /* ─────────────────────────────────────────── ABOUT ────────────────────────────────────────── */
  .about {
    display: grid;
    grid-template-columns: 45fr 55fr;
    min-height: 90vh;
  }

  .about-photo {
    overflow: hidden;
    background: var(--color-hero-bg);
  }
  .about-photo img {
